# Copy to listen_service/.env and edit paths for your host.

# Discrete Speech LM checkpoint (D1b confirm_v2 seed43).
CKPT_PATH=/home/adam/projects/tts-self/runs/discrete_speech_lm_d1b_confirm_v2_seed43/best.pt

# Qwen3.5 text tokenizer (must match Wave-1 text_ids / model.vocab_size=248077).
TOKENIZER_PATH=/home/adam/datasets/tts/models/Qwen3.5-0.8B-Base

# Optional: frozen Qwen3-TTS Tokenizer-12Hz (default: auto-resolve via minispeech).
# CODEC_MODEL_ID=/home/adam/datasets/tts/models/Qwen3-TTS-Tokenizer-12Hz

# Default device for first load: cuda | cpu
# If cuda is set but torch has no CUDA build / no GPU, the app falls back to cpu.
# Prefer leaving unset to auto-pick: cuda if available else cpu.
DEVICE=cuda

# Gradio bind
HOST=127.0.0.1
PORT=7860

# Default speaker id (ruslan in trackn_v2 / speaker_ruslan.json)
SPEAKER_ID=1088

# Optional HF cache
# HF_HOME=/home/adam/hf_cache
