{
  "id": "homograph",
  "description": "Small Russian stress/homograph challenge (combining acute preferred at infer)",
  "kind": "phrases",
  "n": 8,
  "items": [
    {
      "utt_id": "homo_01",
      "text": "Я заплати́л за́мок, а не замо́к.",
      "note": "за́мок (castle) vs замо́к (lock)"
    },
    {
      "utt_id": "homo_02",
      "text": "Мука́ для хлеба, а му́ка — это страдание.",
      "note": "мука́ / му́ка"
    },
    {
      "utt_id": "homo_03",
      "text": "Он уже́ написа́л письмо́.",
      "note": "уже́ vs у́же"
    },
    {
      "utt_id": "homo_04",
      "text": "Сто́ит дом на горе́, и он того́ сто́ит.",
      "note": "сто́ит (costs/worth) vs стои́т (stands)"
    },
    {
      "utt_id": "homo_05",
      "text": "Бе́лки живут в лесу, а белки́ глаз белые.",
      "note": "бе́лки / белки́"
    },
    {
      "utt_id": "homo_06",
      "text": "По́том нельзя, а пото́м можно.",
      "note": "по́том / пото́м"
    },
    {
      "utt_id": "homo_07",
      "text": "А́тлас географический, а атла́с — ткань.",
      "note": "а́тлас / атла́с"
    },
    {
      "utt_id": "homo_08",
      "text": "О́рганы власти и о́рганы в теле — разные слова.",
      "note": "stress contrast organ"
    }
  ]
}
